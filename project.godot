; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kamikamace"
run/main_scene="uid://caqn21j4sbamt"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.09411765, 0.043137256, 0.003921569, 1)
boot_splash/image="uid://dakfbm707cle7"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"
general/default_playback_type.web=0

[autoload]

SoundtrackPlayer="*res://scenes/SoundtrackPlayer.tscn"
GlobalEffects="*res://scenes/GlobalEffects.tscn"

[display]

window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
